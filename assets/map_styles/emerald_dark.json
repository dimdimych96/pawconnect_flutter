{
  "version": 8,
  "name": "PawConnect Emerald Obsidian",
  "metadata": {
    "pawconnect:palette": "obsidian-emerald",
    "description": "Apple Liquid Glass dark map theme with enhanced emerald green parks and obsidian dark roads"
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#0A0A0C"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#0C1622",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "landuse_park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#1E432E",
        "fill-opacity": 0.85,
        "fill-outline-color": "#2E6B47"
      }
    },
    {
      "id": "landcover_grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", "subclass", "grass"],
      "paint": {
        "fill-color": "#1A3B29",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "paint": {
        "fill-color": "#141418",
        "fill-outline-color": "#1C1C22"
      }
    },
    {
      "id": "road_minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service", "track"],
      "paint": {
        "line-color": "#1F1F24",
        "line-width": 1.2
      }
    },
    {
      "id": "road_primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "primary", "secondary", "tertiary", "trunk", "motorway"],
      "paint": {
        "line-color": "#2C2C32",
        "line-width": 2.0
      }
    },
    {
      "id": "road_pedestrian",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "path", "pedestrian", "footway", "cycleway"],
      "paint": {
        "line-color": "#24332A",
        "line-width": 1.5
      }
    }
  ]
}
